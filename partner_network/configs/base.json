  "capture": true,
  "tcp_congestion": {"robot":"cubic","edge":"cubic","proxy":"cubic","worker":"cubic"},
  "sites": {
    "A": {"forward":{"delay_ms":0,"loss_pct":0,"rate_mbit":null,"limit_packets":1000},"reverse":{"delay_ms":0,"loss_pct":0,"rate_mbit":null,"limit_packets":1000}},
    "B": {"forward":{"delay_ms":0,"loss_pct":0,"rate_mbit":null,"limit_packets":1000},"reverse":{"delay_ms":0,"loss_pct":0,"rate_mbit":null,"limit_packets":1000}}
  },
  "impairment_schedule": [],
  "traffic": {
    "command":{"rate_hz":2,"payload_bytes":100},
    "status":{"rate_hz":5,"payload_bytes":100},
    "odometry":{"rate_hz":20,"payload_bytes":250},
    "sensor":{"rate_hz":5,"payload_bytes":20000}
  },
  "deadlines_ms":{"command":100,"status":200,"odometry":100,"sensor":1000}
}
