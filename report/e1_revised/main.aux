\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.5.5}Resource demand}{16}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Historical loopback process CPU consumption. Points average three runs; bars show minimum--maximum. Multithreaded process CPU can exceed 100 percent.}}{17}{}\protected@file@percent }
\newlabel{fig:e1r-historical-fig5-cpu}{{13}{17}{}{figure.13}{}}
