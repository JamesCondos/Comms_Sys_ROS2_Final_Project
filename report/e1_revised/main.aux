\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.2}Controlled restrictions and repetitions}{2}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Revised matrix: four reference source counts and three single-restriction diagnostics, each repeated five times (35 runs).}}{2}{}\protected@file@percent }
\newlabel{tab:e1r-conditions}{{3}{2}{}{table.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.3}Timing boundaries and metrics}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Additive latency decomposition. Dispatch includes the hold and serialization. Request-to-server and response-return intervals include software work; neither is pure propagation time. The server stage includes its small receive-to-processing-start gap.}}{3}{}\protected@file@percent }
\newlabel{tab:e1r-stages}{{4}{3}{}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Actual source-node scaling on the reference path}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Reference-path throughput versus actual ROS 2 source nodes. The dashed line is 32 messages/s per source. Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{4}{}\protected@file@percent }
\newlabel{fig:e1r-source-throughput}{{1}{4}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Class-specific p95 latency on the reference path. Each curve represents one class within the same mixed traffic. Successful messages only. Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{5}{}\protected@file@percent }
\newlabel{fig:e1r-source-latency}{{2}{5}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Process CPU consumption on the reference path, normalised to one logical CPU. Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{6}{}\protected@file@percent }
\newlabel{fig:e1r-source-cpu}{{3}{6}{}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Locating the effect of a controlled restriction}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Throughput at eight actual sources (nominal aggregate rate 256 messages/s). Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{7}{}\protected@file@percent }
\newlabel{fig:e1r-diagnostic-throughput}{{4}{7}{}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Supporting diagnostic means at eight sources. Mb/s denotes delivered application payload; drops denote FIFO admission losses. Command misses include unsuccessful messages. Activity fractions are wall-time occupancy, not CPU percentages.}}{7}{}\protected@file@percent }
\newlabel{tab:e1r-diagnostic-metrics}{{5}{7}{}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean FIFO occupancy at eight sources, excluding the in-service request. The dashed line marks capacity. Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{8}{}\protected@file@percent }
\newlabel{fig:e1r-diagnostic-queue}{{5}{8}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-class successful-message p95 at eight sources. The vertical axis is logarithmic. Points or bar heights are means of five run-level statistics; error bars show the observed minimum and maximum, not confidence intervals.}}{9}{}\protected@file@percent }
\newlabel{fig:e1r-diagnostic-latency}{{6}{9}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Additive mean latency for successful measurement-cohort messages, including drain completions. Components average five run means. These are not p95 components; no stacked error bars are inferred from component ranges.}}{10}{}\protected@file@percent }
\newlabel{fig:e1r-diagnostic-stages}{{7}{10}{}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Service-path means from the same successful cohort as the stacked figure. Dispatch includes serialization and any gateway hold; the server stage includes its small pre-processing gap.}}{10}{}\protected@file@percent }
\newlabel{tab:e1r-small-stages}{{6}{10}{}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Process CPU consumption under controlled restrictions at eight sources. Bars average five runs; error bars show observed minima and maxima. CPU is normalised to one logical CPU.}}{11}{}\protected@file@percent }
\newlabel{fig:e1r-diagnostic-cpu}{{8}{11}{}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Diagnosis combines the manipulated condition with measured stages. Similar queue and latency symptoms alone do not identify a bottleneck.}}{11}{}\protected@file@percent }
\newlabel{tab:e1r-evidence}{{7}{11}{}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Occupied-time means over five runs. Sender is dequeue to response completion; dispatch is dequeue to request start; handler includes waiting for the request body; processing is the explicit server processing interval. These overlap and must not be added.}}{12}{}\protected@file@percent }
\newlabel{tab:e1r-activity}{{8}{12}{}{table.8}{}}
